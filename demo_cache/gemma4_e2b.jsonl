{"key": "101d53ee1f9be54961978a05f7742b89b9dc280475f238593d2c30671972638f", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef k_most_frequent(nums, k):\n    counts = {}\n    first = {}\n    for i, n in enumerate(nums):\n        counts[n] = counts.get(n, 0) + 1\n        if n not in first: first[n] = i\n    return sorted(counts.keys(), key=lambda x: (-counts[x], first[x]))[:k]\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
{"key": "0ccf3d03fafa35e0a55d6c0004b9e136f48c6ca5563a19dbfd9e0095fde13d19", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef run_length_encoding(s):\n    if not s: return []\n    res = []\n    cur, cnt = s[0], 1\n    for ch in s[1:]:\n        if ch == cur: cnt += 1\n        else:\n            res.append([cur, cnt])\n            cur, cnt = ch, 1\n    res.append([cur, cnt])\n    return res\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
{"key": "09515b1fb9ac5a2cb15ab9608062cbf8f74d6ca1bf35181d2225eecec18811da", "response": {"error": null, "latency_s": 0.05, "raw": {"choices": [{"message": {"content": "```python\ndef second_largest(nums):\n    dist = sorted(list(set(nums)), reverse=True)\n    return dist[1] if len(dist) >= 2 else None\n```", "tool_calls": []}}], "usage": {"completion_tokens": 10, "prompt_tokens": 10}}}}
